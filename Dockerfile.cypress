FROM golang:1.27.3 AS base

WORKDIR /easi/

FROM base AS modules

COPY go.mod go.sum ./
RUN go mod download

FROM modules AS build

COPY cmd ./cmd
COPY pkg ./pkg

# TODO(EASI-5064): bump to cypress/base:24.22.1 once Cypress publishes it.
FROM cypress/base:24.22.0

# Node 24.22.0's bundled CA store still trusts the compromised eMudhra
# intermediates (https://we-have-a-problem.com), so upgrade Debian's patched
# ca-certificates and have yarn install (which also downloads the Cypress
# binary) use it via --use-openssl-ca instead of Node's bundled store.
RUN apt-get update && \
	apt-get install -y --no-install-recommends ca-certificates && \
	rm -rf /var/lib/apt/lists/*

# mc - minio client, used for tagging uploaded files
# quay.io/minio/mc lost anonymous pull access (Sep 2026) and MinIO's own GitHub repo is now
# archived; pgsty/mc is an actively-maintained, CLI-compatible fork (still ships the `mc` binary
# at the same path) freely published to Docker Hub.
COPY --from=docker.io/pgsty/mc:RELEASE.2026-09-16T00-00-00Z /usr/bin/mc /mc

COPY package.json yarn.lock /
# RUN npm install -g yarn
RUN NODE_OPTIONS=--use-openssl-ca yarn install --immutable

COPY cypress /cypress
COPY cypress.config.ts /
COPY tsconfig.json /
COPY src /src
COPY scripts/tag_minio_file /scripts/tag_minio_file

ENTRYPOINT ["/node_modules/.bin/cypress"]
CMD ["run"]
