FROM golang:1.26.8 AS base

WORKDIR /easi/

FROM base AS modules

COPY go.mod go.sum ./
RUN go mod download

FROM modules AS build

COPY cmd ./cmd
COPY pkg ./pkg

FROM cypress/base:20.14.0

# mc - minio client, used for tagging uploaded files
# quay.io/minio/mc lost anonymous pull access (Sep 2026) and MinIO's own GitHub repo is now
# archived; pgsty/mc is an actively-maintained, CLI-compatible fork (still ships the `mc` binary
# at the same path) freely published to Docker Hub.
COPY --from=docker.io/pgsty/mc:latest /usr/bin/mc /mc

COPY package.json yarn.lock /
# RUN npm install -g yarn
RUN yarn install --immutable

COPY cypress /cypress
COPY cypress.config.ts /
COPY tsconfig.json /
COPY src /src
COPY scripts/tag_minio_file /scripts/tag_minio_file

ENTRYPOINT ["/node_modules/.bin/cypress"]
CMD ["run"]
