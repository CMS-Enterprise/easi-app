# TODO: move to node:24.22.1 once Docker Hub publishes it (tag exists but has
# no images yet). 24.22.0's bundled CA store still trusts the compromised eMudhra
# intermediates (https://we-have-a-problem.com), so upgrade the distro's patched
# ca-certificates and have yarn use it via --use-openssl-ca.
FROM node:24.22.0

RUN apt-get update && \
	apt-get install -y --no-install-recommends ca-certificates && \
	rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN NODE_OPTIONS=--use-openssl-ca yarn global add serve
COPY build /app
