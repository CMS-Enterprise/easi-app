{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "$ref": "#/definitions/EASIIntake",
  "title": "EASIIntakeV08",
  "definitions": {
    "EASIFundingSource": {
      "required": [
        "fundingSourceId"
      ],
      "properties": {
        "fundingSourceId": {
          "type": "string",
          "description": "Unique ID of this funding source",
          "examples": [
            "91e5c1f3-11fb-4124-805c-adbdd02c5395"
          ]
        },
        "fundingNumber": {
          "type": "string",
          "description": "six digit funding number",
          "examples": [
            "123456"
          ]
        },
        "fundingSource": {
          "type": "string",
          "description": "Source of funding",
          "examples": [
            "Prog Ops"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object"
    },
    "EASIIntake": {
      "required": [
        "intakeId",
        "businessNeed",
        "businessOwner",
        "businessOwnerComponent",
        "collaboratorName508",
        "component",
        "costIncrease",
        "existingContract",
        "processStatus",
        "productManager",
        "productManagerComponent",
        "projectName",
        "requestType",
        "requester",
        "solution",
        "status",
        "submittedAt",
        "userEUA",
        "decisionState",
        "draftBusinessCaseState",
        "finalBusinessCaseState",
        "requestFormState",
        "state",
        "step"
      ],
      "properties": {
        "intakeId": {
          "type": "string",
          "description": "Unique UUID of this system intake",
          "examples": [
            "0a16ce4e-8d8a-41ab-aeba-9303067f065b"
          ]
        },
        "adminLead": {
          "type": "string",
          "description": "Government Admin responsible for handling request",
          "examples": [
            "John Doe"
          ]
        },
        "archivedAt": {
          "type": "string",
          "description": "Timestamp of when request was archived",
          "examples": [
            "2022-02-17T14:34:43Z"
          ]
        },
        "businessNeed": {
          "type": "string",
          "description": "Business Need for the effort detailed in this request",
          "examples": [
            "Process takes too long and holds up key stakeholders"
          ]
        },
        "businessOwner": {
          "type": "string",
          "description": "Person who owns a line of business related to this request",
          "examples": [
            "John Doe"
          ]
        },
        "businessOwnerComponent": {
          "type": "string",
          "description": "Component of the Business Owner",
          "examples": [
            "OIT"
          ]
        },
        "collaboratorName508": {
          "type": "string",
          "description": "508 Collaborator",
          "examples": [
            "John Doe"
          ]
        },
        "component": {
          "type": "string",
          "description": "Component of the person who submitted this request",
          "examples": [
            "OIT"
          ]
        },
        "contractEndDate": {
          "type": "string",
          "description": "The contract's end date",
          "examples": [
            "2026-10-20"
          ]
        },
        "contractStartDate": {
          "type": "string",
          "description": "The contract's start date",
          "examples": [
            "2022-10-20"
          ]
        },
        "contractVehicle": {
          "type": "string",
          "description": "Contract vehicle for this effort",
          "examples": [
            "8(a)"
          ]
        },
        "contractNumber": {
          "type": "string",
          "description": "Contract number for this effort",
          "examples": [
            "8(a)"
          ]
        },
        "contractor": {
          "type": "string",
          "description": "Contractor who will perform the work detailed in this request",
          "examples": [
            "Oddball"
          ]
        },
        "costIncrease": {
          "type": "string",
          "description": "Is there a cost increase associated with this request",
          "examples": [
            "YES",
            "NOT_SURE"
          ]
        },
        "costIncreaseAmount": {
          "type": "string",
          "description": "How much is the cost increase",
          "examples": [
            "Over two million dollars"
          ]
        },
        "decidedAt": {
          "type": "string",
          "description": "Timestamp of when decision was reached",
          "examples": [
            "2022-02-17T14:34:43Z"
          ]
        },
        "decisionNextSteps": {
          "type": "string",
          "description": "Steps that the Business Owner should take after receiving their decision",
          "examples": [
            "Go get a contract"
          ]
        },
        "eaCollaboratorName": {
          "type": "string",
          "description": "Enterprise Architecture (EA) Collaborator",
          "examples": [
            "John Doe"
          ]
        },
        "eaSupportRequest": {
          "type": "boolean",
          "description": "Does the request need EA support"
        },
        "existingContract": {
          "type": "string",
          "description": "Is there an existing contract for this effort",
          "examples": [
            "HAVE_CONTRACT"
          ]
        },
        "existingFunding": {
          "type": "boolean",
          "description": "Will this project be funded out of an existing source"
        },
        "fundingNumber": {
          "type": "string",
          "description": "six digit funding number",
          "examples": [
            "123456"
          ]
        },
        "fundingSource": {
          "type": "string",
          "description": "Source of funding",
          "examples": [
            "Prog Ops"
          ]
        },
        "fundingSources": {
          "items": {
            "$schema": "http://json-schema.org/draft-04/schema#",
            "$ref": "#/definitions/EASIFundingSource"
          },
          "type": "array",
          "description": "Array of funding sources"
        },
        "grbDate": {
          "type": "string",
          "description": "Scheduled date for the Governance Review Board (GRB) meeting",
          "examples": [
            "2025-12-12"
          ]
        },
        "grtDate": {
          "type": "string",
          "description": "Scheduled date for the Governance Review Team (GRT) meeting",
          "examples": [
            "2025-10-20"
          ]
        },
        "issoName": {
          "type": "string",
          "description": "Information System Security Officer (ISSO) for the effort detailed in this request",
          "examples": [
            "John Doe"
          ]
        },
        "lifecycleCostBaseline": {
          "type": "string",
          "description": "Cost baseline associated with this LCID",
          "examples": [
            "about $10 million"
          ]
        },
        "lifecycleExpiresAt": {
          "type": "string",
          "description": "Expiration date for the LCID associated with this request",
          "examples": [
            "2030-12-23"
          ]
        },
        "lifecycleID": {
          "type": "string",
          "description": "LCID (if one is issued) associated with this request",
          "examples": [
            "220970"
          ]
        },
        "lifecycleScope": {
          "type": "string",
          "description": "Scope of LCID",
          "examples": [
            "This LCID covers development and operation of the application"
          ]
        },
        "oitSecurityCollaboratorName": {
          "type": "string",
          "description": "OIT's Security and Privacy (ISPG) Collaborator",
          "examples": [
            "John Doe"
          ]
        },
        "processStatus": {
          "type": "string",
          "description": "Where is the Business Owner in process",
          "examples": [
            "Initial development underway"
          ]
        },
        "productManager": {
          "type": "string",
          "description": "Product Manager for the effort deatiled in this request",
          "examples": [
            "John Doe"
          ]
        },
        "productManagerComponent": {
          "type": "string",
          "description": "Component of the Product Manager",
          "examples": [
            "OIT"
          ]
        },
        "projectAcronym": {
          "type": "string",
          "description": "Acronym for project",
          "examples": [
            "EASi"
          ]
        },
        "projectName": {
          "type": "string",
          "description": "Name of project",
          "examples": [
            "Easy Access to System Information"
          ]
        },
        "rejectionReason": {
          "type": "string",
          "description": "Reasoning for why this request was rejected",
          "examples": [
            "Costs too much money"
          ]
        },
        "requestType": {
          "type": "string",
          "description": "Type of request",
          "examples": [
            "NEW"
          ]
        },
        "requester": {
          "type": "string",
          "description": "Person who submitted request in EASi",
          "examples": [
            "John Doe"
          ]
        },
        "requesterEmailAddress": {
          "type": "string",
          "description": "Email address of the person who submitted this request",
          "examples": [
            "John.Doe@cms.hhs.gov"
          ]
        },
        "solution": {
          "type": "string",
          "description": "Initial solution",
          "examples": [
            "Build new application in ServiceNow"
          ]
        },
        "status": {
          "type": "string",
          "description": "Current status of this request",
          "examples": [
            "INTAKE_SUBMITTED"
          ]
        },
        "submittedAt": {
          "type": "string",
          "description": "Timestamp of when request was submitted",
          "examples": [
            "2022-02-17T14:34:43Z"
          ]
        },
        "trbCollaboratorName": {
          "type": "string",
          "description": "Technical Review Board (TRB) Collaborator",
          "examples": [
            "John Doe"
          ]
        },
        "userEUA": {
          "type": "string",
          "description": "EUA id of the requester",
          "examples": [
            "J8YN"
          ]
        },
        "hasUiChanges": {
          "type": "boolean",
          "description": "Does the request have UI changes"
        },
        "usesAiTech": {
          "type": "boolean",
          "description": "Does the request use AI technology"
        },
        "usingSoftware": {
          "type": "string",
          "description": "Is the request using software",
          "examples": [
            "Not Sure"
          ]
        },
        "acquisitionMethods": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "description": "Acquisition methods for the software related to this request"
        },
        "currentAnnualSpending": {
          "type": "string",
          "description": "Current annual spending for the request",
          "examples": [
            "Less than $1 million"
          ]
        },
        "currentAnnualSpendingITPortion": {
          "type": "string",
          "description": "Current annual spending IT portion for the request",
          "examples": [
            "25%"
          ]
        },
        "plannedYearOneSpending": {
          "type": "string",
          "description": "Planned year one spending for the request",
          "examples": [
            "Less than $1 million"
          ]
        },
        "plannedYearOneSpendingITPortion": {
          "type": "string",
          "description": "Planned year one spending IT portion for the request",
          "examples": [
            "30%"
          ]
        },
        "scheduledProductionDate": {
          "type": "string",
          "description": "Scheduled production date for the request",
          "examples": [
            "2025-10-20"
          ]
        },
        "currentEstimatedCost": {
          "type": "string",
          "description": "Current estimated annual contract cost for the request",
          "examples": [
            "Less than $1 million"
          ]
        },
        "currentEstimatedCostITPortion": {
          "type": "string",
          "description": "IT portion of the current estimated annual contract cost for the request",
          "examples": [
            "25%"
          ]
        },
        "decisionState": {
          "type": "string",
          "description": "Current decision state for this request",
          "examples": [
            "NO_DECISION",
            "LCID_ISSUED",
            "NOT_APPROVED",
            "NOT_GOVERNANCE"
          ]
        },
        "digitalServiceInteraction": {
          "type": "string",
          "description": "Does the request involve interaction with a digital service",
          "examples": [
            "YES",
            "NO",
            "NOT_SURE"
          ]
        },
        "digitalServiceInteractionDescription": {
          "type": "string",
          "description": "Description of the request's digital service interaction",
          "examples": [
            "Users will submit enrollment updates through a public-facing web form"
          ]
        },
        "doesNotSupportSystems": {
          "type": "boolean",
          "description": "Does this request not support any CEDAR systems"
        },
        "draftBusinessCaseState": {
          "type": "string",
          "description": "Current state of the draft Business Case form",
          "examples": [
            "NOT_STARTED",
            "IN_PROGRESS",
            "EDITS_REQUESTED",
            "SUBMITTED"
          ]
        },
        "estimatedTotalContractValue": {
          "type": "string",
          "description": "Estimated total contract value for the request",
          "examples": [
            "Between $1 million and $5 million"
          ]
        },
        "estimatedTotalContractValueITPortion": {
          "type": "string",
          "description": "IT portion of the estimated total contract value for the request",
          "examples": [
            "30%"
          ]
        },
        "finalBusinessCaseState": {
          "type": "string",
          "description": "Current state of the final Business Case form",
          "examples": [
            "NOT_STARTED",
            "IN_PROGRESS",
            "EDITS_REQUESTED",
            "SUBMITTED"
          ]
        },
        "governanceTeamsIsPresent": {
          "type": "boolean",
          "description": "Whether governance team contacts are present for this request"
        },
        "lcidType": {
          "type": "string",
          "description": "Type of LCID issued for this request",
          "examples": [
            "NEW_SYSTEM",
            "RECOMPETE"
          ]
        },
        "lcidComponent": {
          "type": "string",
          "description": "CMS component associated with the LCID",
          "examples": [
            "OFFICE_OF_INFORMATION_TECHNOLOGY_OIT"
          ]
        },
        "lcidIsLowIt": {
          "type": "boolean",
          "description": "Whether the LCID is marked as low IT"
        },
        "lcidIsShortened": {
          "type": "boolean",
          "description": "Whether the LCID duration was shortened"
        },
        "lcidExpirationAlertTS": {
          "type": "string",
          "description": "Timestamp of the last LCID expiration alert for this request",
          "format": "date-time",
          "examples": [
            "2025-10-20T14:34:43Z"
          ]
        },
        "lcidRetiresAt": {
          "type": "string",
          "description": "Retirement date for the LCID associated with this request",
          "format": "date-time",
          "examples": [
            "2030-12-23T14:34:43Z"
          ]
        },
        "lcidIssuedAt": {
          "type": "string",
          "description": "Timestamp of when the LCID associated with this request was issued",
          "format": "date-time",
          "examples": [
            "2025-10-20T14:34:43Z"
          ]
        },
        "priorityAlignment": {
          "type": "string",
          "description": "The ways this effort aligns with organizational priorities",
          "examples": [
            "Aligns with CMS modernization goals"
          ]
        },
        "protectedCmsDataAccessedOutside": {
          "type": "string",
          "description": "Will protected CMS data be accessed outside CMS systems",
          "examples": [
            "YES",
            "NO",
            "NOT_SURE"
          ]
        },
        "protectedCmsDataAccessedOutsideDescription": {
          "type": "string",
          "description": "Description of protected CMS data accessed outside CMS systems",
          "examples": [
            "Contractor staff will access beneficiary data through approved secure tooling"
          ]
        },
        "requestFormState": {
          "type": "string",
          "description": "Current state of the intake request form",
          "examples": [
            "NOT_STARTED",
            "IN_PROGRESS",
            "EDITS_REQUESTED",
            "SUBMITTED"
          ]
        },
        "state": {
          "type": "string",
          "description": "Whether the intake request is open or closed",
          "examples": [
            "OPEN",
            "CLOSED"
          ]
        },
        "step": {
          "type": "string",
          "description": "Current step in the intake workflow",
          "examples": [
            "INITIAL_REQUEST_FORM",
            "DRAFT_BUSINESS_CASE",
            "DECISION_AND_NEXT_STEPS"
          ]
        },
        "trbFollowUpRecommendation": {
          "type": "string",
          "description": "Recommendation for whether the requester should follow up with TRB",
          "examples": [
            "STRONGLY_RECOMMENDED",
            "RECOMMENDED_BUT_NOT_CRITICAL",
            "NOT_RECOMMENDED"
          ]
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp of when request was last updated",
          "format": "date-time",
          "examples": [
            "2025-10-20T14:34:43Z"
          ]
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  }
}